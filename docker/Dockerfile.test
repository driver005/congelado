# ── Congelado Tests ────────────────────────────────────────────────────────────
# Runs integration tests against the engine's routes purely over HTTP — docker/test/run.sh only
# curls the remote `server` service, it never executes a local congelado binary. This image
# previously carried a full "FROM archlinux AS builder" compile stage (identical to
# Dockerfile.server's) plus COPY'd the compiled binary/plugins/workers/libs in — none of which
# run.sh ever actually uses. Dropped entirely: no compile, no build/ artifacts, just curl/jq/
# openssl and the test scripts.
# ────────────────────────────────────────────────────────────────────────────────

FROM archlinux:latest AS runtime

RUN pacman -Syu --noconfirm \
    && pacman -S --noconfirm --needed ca-certificates curl jq openssl bash \
    && pacman -Scc --noconfirm

WORKDIR /app

# Copy test scripts and payloads
COPY docker/test/run.sh ./test/run.sh
COPY docker/test/task_def.json ./test/task_def.json
COPY docker/test/workflow_def.json ./test/workflow_def.json
RUN chmod +x ./test/run.sh

ENTRYPOINT ["./test/run.sh"]
