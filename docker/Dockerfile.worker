# ── Congelado Worker ────────────────────────────────────────────────────────────
# Runtime-only image — compiled artifacts arrive via the shared `build_output` volume, produced
# once by the `builder` service (see docker/Dockerfile.builder + the `builder`/`worker` entries
# in docker-compose.yml, which mounts that volume at /app/build and gates this container on
# `builder` finishing first via `depends_on: condition: service_completed_successfully`).
# Base: Arch Linux — matches the toolchain this project is actually developed against, for the
# runtime .so ABI compatibility this image still needs even though it no longer compiles
# anything itself.
# ────────────────────────────────────────────────────────────────────────────────

FROM archlinux:latest AS runtime

# Runtime needs libc++/liburing (dynamically linked, matching the builder's toolchain) plus the
# X11/xcb chain pulled transitively into cpython's Tk support at build time — `tk` brings the
# same X11/xcb libs in as runtime deps that the builder had as headers. krb5 provides
# libgssapi_krb5.so.2 — needed now that the worker actually finds build/plugins/ (see the
# argv[0]-relative path note below) and loads libpostgres_plugin.so along with everything else
# in that directory; previously a flattened binary path silently pointed the plugin scan at a
# nonexistent directory, so this dependency was never exercised.
# kmod provides modprobe — used at container start to load the host's kTLS ("tls") kernel
# module for outbound TLS connections (WorkerContext::call_engine/ClientRuntime). Needs
# cap_add: SYS_MODULE + a bind mount of the host's /lib/modules in docker-compose.yml to
# actually work — see Dockerfile.server's CMD comment for the full explanation.
RUN pacman -Syu --noconfirm \
    && pacman -S --noconfirm --needed gcc-libs libc++ libc++abi liburing tk krb5 kmod \
       libfontenc libice libsm libxaw libxcomposite libxcursor libxdamage libxtst \
       libxinerama libxkbfile libxrandr libxres xcb-util-wm xcb-util-image \
       xcb-util-keysyms xcb-util-renderutil libxxf86vm libxv xcb-util xcb-util-cursor \
    && pacman -Scc --noconfirm

WORKDIR /app

# Copy worker config
COPY config/worker.toml ./worker.toml

# build/ itself (binary, plugins, workers, libs) is NOT copied here — it arrives at container
# start via the build_output volume mounted at ./build (read-only), populated once by the
# `builder` service. LD_LIBRARY_PATH points at the nested lib location that volume preserves.
ENV LD_LIBRARY_PATH=/app/build/linux/x86_64/debug:$LD_LIBRARY_PATH
# worker scans the same build/plugins/ as server and can load python_bridge_plugin too — same
# PYTHONHOME need, see Dockerfile.server's comment.
ENV PYTHONHOME=/app/build/python-stdlib

# run_worker()'s argv[0]-relative plugin-dir lookup ("<binary's own dir>/../../../plugins", same
# offset math as src/main.cc — see src/worker_main.cc) needs the binary invoked at its real
# nested build/linux/x86_64/debug/ path, not flattened, so that offset lands on build/plugins
# instead of the filesystem root. Passing "./build/workers" explicitly as the internal-workers-dir
# argument for the same reason — its own default ("./workers") assumed the old flattened layout.
CMD ["sh", "-c", "modprobe tls 2>/dev/null || true; exec ./build/linux/x86_64/debug/congelado_worker worker.toml ./build/workers"]
