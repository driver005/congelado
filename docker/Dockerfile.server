# ── Congelado Server ────────────────────────────────────────────────────────────
# Multi-stage build: C++26 engine with xmake + Conan + Clang 20
# ────────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Builder ───────────────────────────────────────────────────────────
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget gnupg ca-certificates lsb-release software-properties-common \
    python3 python3-pip git unzip \
    && rm -rf /var/lib/apt/lists/*

# Clang 20 + LLD
RUN wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key | tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc \
    && echo "deb http://apt.llvm.org/noble/ llvm-toolchain-noble-20 main" \
       > /etc/apt/sources.list.d/llvm-20.list \
    && apt-get update && apt-get install -y --no-install-recommends \
       clang-20 lld-20 libc++-20-dev libc++abi-20-dev \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-20 100 \
    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-20 100 \
    && update-alternatives --install /usr/bin/lld lld /usr/bin/lld-20 100

# xmake
RUN curl -fsSL https://xmake.io/shget.text | bash \
    && ln -sf /root/.local/bin/xmake /usr/local/bin/xmake

# Conan 2
RUN pip3 install --no-cache-dir conan \
    && conan profile detect --force

# Copy project
WORKDIR /app
COPY . .

# Configure xmake
RUN xmake f -c -v -y

# Install Conan dependencies
RUN xmake require --force

# Build all targets
RUN xmake build congelado congelado_lib

# Build plugins
RUN xmake build engine file_logger http2

# Build workers
RUN xmake build echo transform

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libstdc++6 libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy built artifacts
COPY --from=builder /app/build/linux/x86_64/debug/bin/congelado ./congelado
COPY --from=builder /app/build/linux/x86_64/debug/plugins/ ./plugins/
COPY --from=builder /app/build/linux/x86_64/debug/workers/ ./workers/
COPY --from=builder /app/build/linux/x86_64/debug/libcongelado_lib.so ./libcongelado_lib.so

# Copy config
COPY src/congelado.toml ./congelado.toml

# Generate self-signed TLS certs
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && openssl req -x509 -newkey rsa:2048 -nodes \
       -keyout server.key -out server.crt \
       -days 365 -subj "/CN=localhost" \
    && rm -rf /var/lib/apt/lists/*

# LD_LIBRARY_PATH for shared libs
ENV LD_LIBRARY_PATH=/app:$LD_LIBRARY_PATH

EXPOSE 8080

CMD ["./congelado"]
