# ── Congelado UI (Flutter app) ─────────────────────────────────────────────────
# Builds flutter/ui/'s web target inside a container that actually carries the
# Flutter SDK (this repo's own dev environment doesn't), then serves the static
# output with a tiny web server. Independent of the C++ build entirely — no
# shared build_output volume, no builder dependency (see docker-compose.yml's
# `ui` service). flutter/ui has no path dependencies (remix + mix + widgetbook,
# all pub-hosted), so one COPY line suffices.
# ─────────────────────────────────────────────────────────────────────────────────

FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /workspace

COPY flutter/ui ./flutter/ui

WORKDIR /workspace/flutter/ui

# Platform runner folders (web/, linux/, etc.) aren't checked into the repo yet
# — see flutter/ui/README.md — so scaffold just the web target here, inside the
# one place in this project that actually has the Flutter SDK to do it
# correctly. `flutter create` never overwrites lib/ or pubspec.yaml, only fills
# in what's missing.
RUN flutter create --platforms=web --project-name congelado_hero_ui . \
    && flutter pub get \
    && flutter build web --release

FROM nginx:alpine AS runtime

COPY --from=build /workspace/flutter/ui/build/web /usr/share/nginx/html

EXPOSE 80
