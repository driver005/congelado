# Flutter/Dart build artifacts. Platform runner folders (android/, ios/, linux/,
# macos/, windows/, web/) are NOT ignored; they get committed like any normal
# Flutter app once `flutter create` scaffolds them (same convention as app/).
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/

# This package is runnable as an app (lib/main.dart launches the Widgetbook
# catalogue) — commit the lock like app/ does.
!pubspec.lock

# Token pipeline scratch (regenerated)
tool/build/
__pycache__/
*.pyc
