
{% for dep in deps %}
                {{ dep.type }} wrap(std::type_identity<{{ dep.type }}>, const ::{{ dep.handle }}* handle) const noexcept
                {
                    return {{ dep.type }}{m_{{ dep.member }}_ops, const_cast<::{{ dep.handle }}*>(handle)};
                }

{% endfor %}
    const ::{{ struct_name }}& get_vtable() const noexcept
    {
        return m_vtable;
    }

    const ::{{ handle_name }}& get_handle() const noexcept
    {
        return m_handle;
    }

    void register_ops(
        const ::{{ registry_struct }}& registry_ops,
        ::{{ registry_handle }}* registry_handle,
        const {{ string_type }}& type,
        const {{ string_type }}& provider
    ) const noexcept
    {
        registry_ops.register_op(
            registry_handle,
            type.get_handle(),
            provider.get_handle(),
            const_cast<::{{ struct_name }}*>(&m_vtable)
        );
    }

private:
    ::{{ struct_name }} m_vtable;
    ::{{ handle_name }} m_handle;
{% for dep in deps %}
    const ::{{ dep.struct }}* m_{{ dep.member }}_ops{nullptr};
{% endfor %}